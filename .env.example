# ── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=my-gcp-project

# ── GCS bucket (upload migration SQL files here) ──────────────────────────────
GCS_MIGRATION_BUCKET=my-migration-bucket
GCS_MIGRATION_PREFIX=migrations/          # subfolder inside the bucket

# ── Central discovery DB (holds tenant metadata) ───────────────────────────────
DISCOVERY_DB_HOST=127.0.0.1               # or Cloud SQL socket path
DISCOVERY_DB_PORT=3306
DISCOVERY_DB_USER=migration_user
DISCOVERY_DB_PASSWORD=changeme            # injected via Cloud Run --set-secrets
DISCOVERY_DB_NAME=tenants_db
TENANT_METADATA_TABLE=tenant_metadata
TENANT_UUID_COL=tenant_uuid
TENANT_DB_HOST_COL=db_host
TENANT_DB_NAME_COL=db_name
TENANT_DB_PORT_COL=db_port

# ── Secret Manager naming ─────────────────────────────────────────────────────
# Each tenant secret must be named:  {tenant_uuid}_DATABASE_URI
# Secret value format:               mysql://user:pass@host:3306/dbname
SECRET_TENANT_SUFFIX=_DATABASE_URI

# ── Migration history table (created automatically inside each tenant DB) ──────
MIGRATION_HISTORY_TABLE=_migration_history

# ── Concurrency ───────────────────────────────────────────────────────────────
MIGRATION_MAX_WORKERS=10

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=db-migration-service
APP_VERSION=1.0.0
LOG_LEVEL=INFO
